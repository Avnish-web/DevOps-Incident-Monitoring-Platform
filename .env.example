# Copy to .env and replace every placeholder. Never commit .env.
# Variables are introduced here as the phases that use them are implemented.

# --- API service (Phase 2) ---
API_PORT=8080
API_MANAGEMENT_PORT=8081
# local = readable logs; omit for JSON logs
SPRING_PROFILES_ACTIVE=local
# SSRF protection. Keep false unless you intentionally monitor loopback/private addresses.
MONITORING_ALLOW_PRIVATE_TARGETS=false

# --- Worker service (Phase 5) ---
# Internal management port (health). The worker has no public API.
WORKER_MANAGEMENT_PORT=8082
WORKER_CONCURRENCY=20
WORKER_BATCH_SIZE=50
WORKER_POLL_INTERVAL=1s
WORKER_SHUTDOWN_GRACE=20s
WORKER_HTTP_MAX_REDIRECTS=5
WORKER_HTTP_MAX_BODY=1MB

# --- PostgreSQL (Phase 3) ---
# Used by both the postgres container and the API. Pick a strong password, e.g.:
#   openssl rand -base64 24
DB_HOST=localhost
# Host port for the dev database. Use 5433 if a locally installed PostgreSQL already uses 5432.
DB_PORT=5432
DB_POOL_SIZE=10
POSTGRES_DB=monitoring
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=change-me

# --- Redis (Phase 5/12) ---
REDIS_PASSWORD=change-me

# --- Grafana (Phase 11) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
